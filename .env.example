# Last.fm API Credentials
# Get from https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_API_SECRET=your-lastfm-api-secret
LASTFM_USERNAME=your-username
LASTFM_PASSWORD=your-password

# Discogs API Credentials
# Get from https://www.discogs.com/settings/developers
DISCOGS_USER_TOKEN=your-discogs-token
DISCOGS_USERNAME=your-discogs-username

# Google Gemini API (required for recognition + visual embeddings)
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: vision model for cover ID (default: gemini-3.5-flash-lite)
# Cheaper: gemini-3.1-flash-lite | Higher accuracy: gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
